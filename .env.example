# Shaghilni settings. Copy to .env and edit; real environment variables take precedence.

# development | production
NODE_ENV=development
PORT=3000
# Required in production: your public https:// address, exactly: https://shaghilni.sy
BASE_URL=
# Put the database on a persistent disk in production, e.g. /data/shaghilni.db
DB_PATH=data/shaghilni.db

# Numbers that become admins when they sign in (international format, comma-separated)
ADMIN_PHONES=+963944000000

# Required in production: a random secret of at least 32 characters
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_PEPPER=
# Development only: show sign-in codes on screen
OTP_DEV_ECHO=true
SESSION_DAYS=30
# Invisible sign-in challenge against bots (each +1 doubles the work; 0 turns it off)
OTP_POW_BITS=14

# Text messages: console (log only) | textbee (Android phone with a local SIM) | twilio
SMS_PROVIDER=console
TEXTBEE_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Texts only go to these country codes (admin numbers are always allowed). Blocks SMS-pumping fraud.
SMS_ALLOWED_PREFIXES=+963
# Most texts the whole site sends per day (UTC); beyond it, sign-in pauses until midnight
SMS_DAILY_CAP=1000

# Optional: Claude in the resume helper (wording suggestions and translation drafts)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
# Most Claude calls per day (suggestions and translations): whole site, and per person
AI_DAILY_CAP=300
AI_USER_DAILY_CAP=30

# Development only: add the 19 sample listings on first start (added once; never again after npm run demo:remove).
# Ignored when NODE_ENV=production: sample data is never added there.
SEED_DEMO=true
# true behind Render, Railway, Fly, nginx or Caddy; false when nothing sits in front of the server
TRUST_PROXY=false

# Requests per minute per address: all API calls, and changes
API_RATE_LIMIT=600
WRITE_RATE_LIMIT=240

# Shown in the privacy notice and terms of use. Set both before launch.
LEGAL_NAME=
CONTACT_EMAIL=

# Texts abroad: Syria and diaspora countries by default, with their own daily cap
# SMS_ALLOWED_PREFIXES=+963,+49,+90,+961,+962,+964,+20,+971,+966,+974,+965,+46,+31,+43,+45,+47,+33,+32,+44,+1
SMS_INTL_DAILY_CAP=150

# Email for job alerts (any service that accepts {from,to,subject,text} with a bearer key)
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=

# Plan prices shown to employers (leave empty to show "Contact us for pricing")
PLAN_PRO_PRICE=
PLAN_ENTERPRISE_PRICE=

# Demo accounts (a student, a job seeker and a verified company). Never used in production.
DEMO_ACCOUNTS=false

# Card payments (see README). PAY_PROVIDER=qnb once its adapter is completed; test only in development.
PAY_PROVIDER=
PAY_CURRENCY=SYP
PLAN_PRO_MONTHLY=
PLAN_ENTERPRISE_MONTHLY=
QNB_GATEWAY_URL=
QNB_MERCHANT_ID=
QNB_API_SECRET=
QNB_WEBHOOK_SECRET=
